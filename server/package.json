{
  "name": "defesabr-api",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "API do DefesaBR Intelligence — coleta e serve dados públicos de defesa e segurança.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=../.env scripts/preflight.js && node --env-file-if-exists=../.env src/index.js",
    "dev": "node --env-file-if-exists=../.env scripts/preflight.js && node --env-file-if-exists=../.env --watch src/index.js",
    "collect": "node --env-file-if-exists=../.env scripts/collect.js",
    "reclassify": "node scripts/reclassify.js",
    "reset": "node scripts/reset.js",
    "check": "node scripts/check.js",
    "check:auth": "node scripts/check-auth.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
