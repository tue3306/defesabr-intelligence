# Copie este arquivo para ".env" e preencha os valores.
# NUNCA faca commit do arquivo .env com a chave real.

# Chave da API da Anthropic (Claude). Opcional: o site funciona em modo
# demonstracao (dados mockados) quando a chave nao esta presente.
VITE_ANTHROPIC_API_KEY=sk-ant-sua-chave-aqui

# Identidade da aplicacao
VITE_APP_NAME=DefesaBR Intelligence
VITE_APP_VERSION=1.0.0

# Opcional: chave gratuita da Alpha Vantage (acoes do setor defesa).
# Use "demo" para dados de exemplo.
VITE_ALPHAVANTAGE_KEY=demo

# ─────────────────────────────────────────────────────────────────────────────
# CAMADA DE DADOS
# 'mock' (padrao) resolve tudo localmente, com latencia simulada.
# 'api'  passa a consultar VITE_API_BASE_URL usando os mesmos contratos.
# Nenhum componente da interface precisa mudar entre os dois modos.
VITE_DATA_MODE=mock
VITE_API_BASE_URL=
VITE_API_TIMEOUT=12000

# Latencia simulada do modo demonstracao. Use 0 para desligar.
VITE_MOCK_LATENCY=1
