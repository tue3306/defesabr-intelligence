{
  "name": "defesabr-intelligence",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Agregador de fontes públicas sobre defesa e segurança do Brasil — coleta automatizada, API e interface.",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:api": "npm --prefix server run dev",

    "build": "vite build",
    "postinstall": "npm --prefix server install --omit=dev",
    "start": "npm --prefix server start",

    "preview": "vite preview",
    "collect": "npm --prefix server run collect",
    "reclassify": "npm --prefix server run reclassify",
    "reset:db": "npm --prefix server run reset",
    "check": "npm --prefix server run check"
  },
  "dependencies": {
    "framer-motion": "^11.3.24",
    "lucide-react": "^0.427.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^6.26.0",
    "recharts": "^2.12.7",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "vite": "^5.4.0"
  }
}
