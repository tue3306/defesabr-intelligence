{
  "name": "defesabr-intelligence",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Plataforma de clipping e análise inteligente de notícias sobre Segurança e Defesa (cenário brasileiro).",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:api": "npm --prefix server run dev",
    "build": "vite build",
    "preview": "vite preview",
    "start": "npm --prefix server start",
    "check": "npm --prefix server run check",
    "collect": "npm --prefix server run collect",
    "reclassify": "npm --prefix server run reclassify",
    "reset:db": "npm --prefix server run reset",
    "postinstall": "npm --prefix server install",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "framer-motion": "^11.3.24",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.427.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^6.26.0",
    "react-simple-maps": "^3.0.0",
    "recharts": "^2.12.7",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "gh-pages": "^6.1.1",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "vite": "^5.4.0"
  }
}
